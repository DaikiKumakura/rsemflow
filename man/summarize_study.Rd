\name{summarize_study}
\alias{summarize_study}
\title{Expression-level sample and gene summaries}
\usage{
summarize_study(study)
}
\arguments{\item{study}{An \code{rsemflow_study} or study path.}}
\value{A list with \code{samples} and \code{genes} data frames.}
\description{Computes expression-level QC summary statistics without making exclusion decisions.}
